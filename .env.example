# Configuration Brevo (anciennement Sendinblue)
# Obtenez votre clé API sur : https://app.brevo.com/settings/keys/api
BREVO_API_KEY=votre_cle_api_brevo

# IDs des listes Brevo (format JSON array)
# Trouvez vos IDs de liste dans Brevo > Contacts > Listes
# Exemple : [2,5] pour ajouter aux listes 2 et 5
BREVO_LIST_IDS=[2]
