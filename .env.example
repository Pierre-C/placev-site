# .env.example — Place V Booking Module
# ─────────────────────────────────────────────────────────────────────────────
# Copier en .env.local et remplir les valeurs.
# NE JAMAIS commiter .env.local dans Git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données ───────────────────────────────────────────────────────────
DATABASE_URL=""

# ── Auth.js v5 ────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=""     # openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"

# ── Stripe ────────────────────────────────────────────────────────────────────
# Phase mock (défaut) : STRIPE_MOCK=true, les clés ne sont pas lues
# Phase réelle : STRIPE_MOCK=false + renseigner les clés sk_test_...
STRIPE_MOCK="true"
NEXT_PUBLIC_STRIPE_MOCK="true"
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ── Email admin ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=""            # destinataire des notifications internes (suppression compte, devis salle)

# ── Brevo ─────────────────────────────────────────────────────────────────────
# Phase mock (défaut) : BREVO_MOCK=true, emails loggés en console uniquement
# Phase réelle : BREVO_MOCK=false + renseigner BREVO_API_KEY
BREVO_MOCK="true"
# BREVO_API_KEY=""
