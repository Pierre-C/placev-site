{
  "name": "placev-site",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "optimize-gallery": "node scripts/optimize-gallery.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:http": "vitest run __tests__/api",
    "test:unit": "vitest run __tests__ --exclude __tests__/api",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:slice1": "playwright test e2e/slice-01-auth.spec.ts",
    "test:e2e:slice2": "playwright test e2e/slice-02-credits.spec.ts",
    "test:e2e:slice3": "playwright test e2e/slice-03-booking.spec.ts",
    "test:e2e:slice5": "playwright test e2e/slice-05-admin.spec.ts",
    "test:all": "npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@getbrevo/brevo": "^3.0.1",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.4.1",
    "@prisma/client": "^7.4.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@types/bcrypt": "^6.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^11",
    "lucide-react": "^0.441.0",
    "next": "14.2.5",
    "next-auth": "^5.0.0-beta.30",
    "prisma": "^7.4.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "^20.3.1",
    "tailwind-merge": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "vitest": "^4.0.18",
    "ws": "^8.19.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.9.1",
    "@types/react": "19.2.2",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.18",
